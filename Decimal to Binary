//Recursive
public static void decimalToBinary(int n){
    if (n > 1){
        decimalToBinary(n /2);
    }
    System.out.println(n % 2);
}


//Iterative
public static String decimalToBinaryIterative(int n) {
    String binary = "";

    if (n == 0) {
        return "0";
    }

    while (n > 0) {
        int remainder = n % 2;
        binary = remainder + binary;
        n = n / 2;                 
    }

    return binary;
}
