// Base class for all users
public abstract class User {

    // Fields for users
    protected String username;
    protected int id;

    // Overloaded Constructor
    public User(String username, int id){
        if (username == null) {
            System.out.println("Invalid username. Using 'Guest'.");
            this.username = "Guest";
        } else {
            this.username = username;
        }

        this.id = id;
    }

    // Getters
    public String getUsername(){
        return username;
    }

    public int getId(){
        return id;
    }

    // Every user states their role
    public abstract String getRole();

    // Display a message to the user
    public void welcomeUser() {
        System.out.println("Welcome, " + username + " (" + getRole() + ")");
    }
}

 class Customer extends User {

     // Fields
     private Product[] cart;  // array of carts
     private int cartCount; // keep track of the amount of items in the cart


     // Overloaded constructor
     public Customer(String username, int id) {
         super(username, id);

         cart = new Product[10];
         cartCount = 0;
     }

     @Override
     public String getRole() {
         return "Customer";
     }

     // Add product to cart
     public void addToCart(Product product) {
         if (cartCount >= cart.length) {
             System.out.println("Cart is full! Cannot add more items.");
             return;
         }

         cart[cartCount] = product;
         cartCount++;

         System.out.println(product.getName() + " added to cart.");
     }

     // Show the items in the cart
     public void viewCart() {
         System.out.println("\n--- Your Cart ---");

         if (cartCount == 0) {
             System.out.println("Cart is empty.");
             return;
         }

         for (int i = 0; i < cartCount; i++) {
             cart[i].displayInfo();
         }
     }


     // Remove item from cart by the product ID
     public void removeFromCart(int productId) {

         int index = -1;

         // Find product
         for (int i = 0; i < cartCount; i++) {
             if (cart[i].getId() == productId) {
                 index = i;
                 break;
             }
         }

         if (index == -1) {
             System.out.println("Item not found in cart.");
             return;
         }

         // Shift items to the left
         for (int j = index; j < cartCount - 1; j++) {
             cart[j] = cart[j + 1];
         }

         cartCount--;
         System.out.println("Removed item with ID: " + productId);
     }

     // Getter for the cart
     public Product[] getCart() {
         return cart;
     }

     public int getCartCount() {
         return cartCount;
     }

     // Create an order from the cart
     public Order checkout(int orderId) {

         if (cartCount == 0) {
             throw new IllegalStateException("Cannot checkout: Your cart is empty.");
         }

         return new Order(cart, cartCount, orderId);

     }
 }



