// A class for a customer's order
public class Order {
    // Fields
    private Product[] products; // The items in the order
    private int orderId;
    private double subtotal;
    private double finalTotal;

    // Overloaded constructor
    public Order(Product[] cart, int itemCount, int orderId) {

        // Handle empty order
        if (itemCount == 0) {
            throw new RuntimeException("Cannot create an order with no items!");
        }

        this.orderId = orderId;

        // Copy only items that are in the cart
        products = new Product[itemCount];
        for (int i = 0; i < itemCount; i++) {
            products[i] = cart[i];
        }

        // Calculate the subtotal
        calculateSubtotal();
        finalTotal = subtotal;

    }


    // Adds up the prices of all products
    private void calculateSubtotal() {
        subtotal = 0;

        for (Product p : products) {
            subtotal += p.getPrice();
        }
    }

    // Applies a discount rule to each product
    public void applyDiscount(PriceRule discountRule) {

        for (Product p : products) {
            double newPrice = discountRule.apply(p);
            p.setPrice(newPrice);
        }

        // Update totals after discount
        calculateSubtotal();
        finalTotal = subtotal;
    }

    // Apply tax to the subtotal
    public void applyTax(PriceRule taxRule) {
        subtotal = taxRule.apply(new TotalProduct(subtotal));
        finalTotal = subtotal;
    }


    // Apply shipping cost
    public void applyShipping(PriceRule shippingRule) {
        finalTotal = shippingRule.apply(new TotalProduct(finalTotal));
    }

    // Display the order details
    public void printOrderSummary() {

        System.out.println("\n======= ORDER SUMMARY =======");
        System.out.println("Order ID: " + orderId);

        // Show each product
        for (Product p : products) {
            p.displayInfo();
        }

        System.out.println("----------------------------");
        System.out.printf("Subtotal: $%.2f%n", subtotal);
        System.out.printf("Final Total: $%.2f%n", finalTotal);
        System.out.println("============================\n");
    }

    // Getter
    public double getFinalTotal() {
        return finalTotal;
    }
}

public interface Discountable {

    double applyDiscount(Product product);
}

class CategoryDiscount implements Discountable{

    @Override
    public double applyDiscount(Product product) {

        // 10% off Electronics
        if (product.getCategory().equals("Electronics")) {
            return product.getPrice() * 0.90;
        }

        // No discount for other categories
        return product.getPrice();
    }
}


public interface PriceRule {

    // Takes a product and returns new price
    double apply(Product product);

}

class TaxRule implements PriceRule {
    public double apply(Product product) {
        return product.getPrice() * 1.07; // 7% tax
    }
}

class ShippingRule implements PriceRule {
    public double apply(Product product) {
        return product.getPrice() + 5.99;
    }
}

import java.util.Scanner;

public class Main {

    // Static array of products
    static Product[] productList;

    // static order ID counter

    static int orderCounter = 1000;

    public static void main(String[] args) {

        Scanner keyb = new Scanner(System.in);

        System.out.println("Welcome to the E-commerce Prototype Platform!");


        // Create products
        Product p1 = new Electronics("Laptop", 999.99, 1, 2);
        Product p2 = new Clothing("T-Shirt", 14.99, 2, "L");
        Product p3 = new Grocery("Milk", 2.49, 3, 7);

        // Add products to product list
        productList = new Product[] { p1, p2, p3 };

        // Create users
        Customer customer = new Customer("Alice", 101);
        Admin admin = new Admin("Admin", 999);

        customer.welcomeUser();
        admin.welcomeUser();

        // Admin views all products
        admin.viewAllProducts(productList);

        // Customer adds items to cart
        customer.addToCart(p1);
        customer.addToCart(p2);
        customer.addToCart(p3);

        // View cart
        customer.viewCart();

        // Customer checks out
        Order order = customer.checkout(orderCounter++);

        // Apply category based discount 
        Discountable discountRule = new CategoryDiscount();
        for (Product p : customer.getCart()) {
            if (p != null) {
                p.setPrice(discountRule.applyDiscount(p));
            }
        }

        // Apply tax and shipping 
        order.applyTax(new TaxRule());
        order.applyShipping(new ShippingRule());

        // Print final order summary
        order.printOrderSummary();

    }
}





        










